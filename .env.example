# Required
CONTACT_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=unc-seat-notifier@example.com
SMTP_TO=you@example.com

# Optional SMTP auth (omit both if your relay doesn't require login)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional, all have defaults
DB_PATH=data/unc_notifier.db
LOG_PATH=logs/unc_notifier.log
WATCHES_PATH=watches.yaml
POLL_INTERVAL_MINUTES=5
JITTER_SECONDS=30
COOLDOWN_MINUTES=30
CIRCUIT_BREAKER_THRESHOLD=5
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=3600
# alert | warn | silent - default policy for sections with an active waitlist,
# overridable per watch entry in watches.yaml
DEFAULT_WAITLIST_POLICY=alert
# How long to wait before retrying a notification that failed to send (e.g. SMTP was
# down). Retries only happen while the section remains available.
NOTIFICATION_RETRY_DELAY_MINUTES=5
